{
  "name": "pi-academic",
  "version": "0.1.0",
  "description": "AI-first academic writing assistant for Humanities researchers — works with pi and oh-my-pi",
  "keywords": [
    "academic-writing",
    "humanities",
    "oh-my-pi",
    "pi-package"
  ],
  "license": "MIT",
  "author": "Yotam Fromm",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackMatanky/pi-academic"
  },
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "typecheck": "cd extensions && npx tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "harper.js": "^2.10.0",
    "typebox": "^1.3.8",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "vite": "^8.3.3",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-mcp-adapter": "*",
    "pi-subagents": "*",
    "pi-web-access": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./extensions/pi-academic/index.ts",
      "./extensions/lifecycle/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/pi-academic.png"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-academic/index.ts",
      "./extensions/lifecycle/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/pi-academic.png",
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
