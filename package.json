{
  "name": "academic-writer",
  "version": "0.5.1",
  "description": "AI-first academic writing assistant for Humanities researchers — pi package",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build-mcp.sh",
    "typecheck": "cd extensions && npx tsc --noEmit",
    "clean": "rm -rf mcp/gemini-server/dist/ mcp/gemini-server/node_modules/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JackMatanky/academic-writer"
  },
  "keywords": [
    "pi-package",
    "academic-writing",
    "humanities"
  ],
  "author": "Yotam Fromm",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pi-subagents": "0.37.0",
    "pi-mcp-adapter": "2.15.0",
    "pi-web-access": "0.14.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  }
}
