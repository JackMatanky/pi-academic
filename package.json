{
  "name": "academic-writer",
  "version": "0.1.0",
  "description": "AI-first academic writing assistant for Humanities researchers — pi package",
  "keywords": [
    "academic-writing",
    "humanities",
    "pi-package"
  ],
  "license": "MIT",
  "author": "Yotam Fromm",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackMatanky/academic-writer"
  },
  "type": "module",
  "scripts": {
    "typecheck": "cd extensions && npx tsc --noEmit"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "typebox": "^1.3.8",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-mcp-adapter": "*",
    "pi-subagents": "*",
    "pi-web-access": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./extensions/pi-academic-writer/index.ts",
      "./extensions/lifecycle/index.ts"
