    "skills": [
      "./skills"
    ],
    "image": "./assets/pi-academic-writer.png"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-academic-writer/index.ts",
      "./extensions/lifecycle/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/pi-academic-writer.png"
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  }
