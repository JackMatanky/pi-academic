{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "jsdoc": {
    "addDefaultToDescription": false,
    "capitalizeDescriptions": true,
    "commentLineStrategy": "multiline",
    "lineWrappingStyle": "greedy",
    "separateReturnsFromParam": true
  },
  "sortImports": {
    "groups": [
      "type",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    ".aw-ts-test/**",
    ".aw-runtime-*/**",
    ".academic-writer/**",
    ".voice/**",
    "past-articles/**",
    "logs/**",
    "uv.lock",
    "package-lock.json",
    "extensions/package-lock.json"
  ]
}
